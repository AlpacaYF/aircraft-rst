{
  "system": "RST-DEDF end-to-end aircraft entity extraction",
  "version": "2026-10-22",
  "default_recipe": "uniform",
  "task": "single image -> per-aircraft {bbox, class (114), domain (military/civilian), confidence}",
  "detector": {
    "arch": "YOLO11x",
    "weights": "runs/detect/det_runs/yolo11x_640_b16/weights/best.pt",
    "classes": ["aircraft"],
    "imgsz": 640,
    "conf": 0.5,
    "epochs": 30,
    "ap50": 93.73,
    "map_50_95": 79.67
  },
  "experts": {
    "uniform": {
      "runs": ["runs/v2_rs_s0", "runs/v2_rt_nosup_s0", "runs/v2_rst_nosup_s0"],
      "roles": ["region+scene", "region+text (adaptive)", "region+scene+text"],
      "supervision": "domain + class only (simplified final recipe)"
    },
    "full": {
      "runs": ["runs/v2_rs_s0", "runs/v2_rt_adapt_s0", "runs/v2_rst_f_s0"],
      "supervision": "full recipe (contrastive + margin + attribute terms)"
    },
    "single": {
      "runs": ["runs/v2_rst_nosup_s0"],
      "note": "no DEDF; one full expert"
    }
  },
  "fusion": "equal-weight logits average over experts (DEDF), no fitted parameters",
  "knowledge": "knowledge/text_features_clipL_en_diff.npz",
  "index": "index/class_meta.json",
  "geometry": {
    "region_input": 384,
    "region_expand": 0.25,
    "channels": 4,
    "scene_trigger_long_side": 896,
    "tile_px": 448,
    "stride_px": 336,
    "near_tokens_per_tile": 49,
    "far_tokens_per_tile": 4,
    "scene_token_cap": 1024
  },
  "thresholds": {
    "detection_conf": 0.5,
    "matching_iou": 0.5,
    "matching": "class-agnostic greedy one-to-one, highest confidence first"
  },
  "metrics_test_3002": {
    "gt_box": {
      "uniform_dedf": {"top1": 93.50, "macro_f1": 92.14},
      "uniform_single_rst": {"top1": 91.77, "macro_f1": 90.50},
      "full_dedf": {"top1": 93.64, "macro_f1": 92.15}
    },
    "end_to_end_yolo_conf05": {
      "uniform_dedf": {
        "precision": 91.36, "recall_gd": 84.30, "f1_gd": 87.69,
        "recall_all_gt": 81.41, "f1_all_gt": 86.11,
        "recognition_top1_given_match": 94.99
      },
      "uniform_single_rst": {
        "precision": 89.83, "recall_gd": 82.89, "f1_gd": 86.22,
        "recall_all_gt": 80.05, "f1_all_gt": 84.66,
        "recognition_top1_given_match": 93.39
      }
    },
    "denominator_note": "gd = GT in images that produced at least one detection (2899); all_gt = 3002. The revised table 4-7 uses all_gt."
  },
  "timing_s": {
    "benchmark_1669_images": {"detect": 0.044, "recognize_dedf": 0.418, "end_to_end": 0.462},
    "single_image_cold": {"detect": 4.27, "load_experts": 9.34, "recognize": 0.58, "total": 14.19}
  },
  "environment": {
    "recognizer": ".venv (torch 2.4.1+cu124)",
    "detector": ".venv-det (ultralytics)",
    "gpu": "RTX 3090 24GB; demo uses ~5-6GB"
  },
  "known_limits": [
    "closed-set 114 classes, no open-set/unknown aircraft",
    "confidence is uncalibrated softmax (ECE ~6-7%)",
    "single seed (seed0) for the deployed experts",
    "detector conf 0.5 may miss small targets or emit overlapping boxes"
  ]
}
